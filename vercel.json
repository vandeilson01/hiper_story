{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?path=/api/:path*"
    },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/conta", "destination": "/index.html" },
    { "source": "/sacola", "destination": "/index.html" },
    { "source": "/checkout", "destination": "/index.html" },
    { "source": "/produto/:id", "destination": "/index.html" }
  ]
}
